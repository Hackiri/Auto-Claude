#!/usr/bin/env bash
set -e
if [[ ! -d "/Users/wm/Projects/Auto-Claude-001-features-develop" ]]; then
  echo "Cannot find source directory; Did you move it?"
  echo "(Looking for "/Users/wm/Projects/Auto-Claude-001-features-develop")"
  echo 'Cannot force reload with this script - use "direnv reload" manually and then try again'
  exit 1
fi

# rebuild the cache forcefully
_nix_direnv_force_reload=1 direnv exec "/Users/wm/Projects/Auto-Claude-001-features-develop" true

# Update the mtime for .envrc.
# This will cause direnv to reload again - but without re-building.
touch "/Users/wm/Projects/Auto-Claude-001-features-develop/.envrc"

# Also update the timestamp of whatever profile_rc we have.
# This makes sure that we know we are up to date.
touch -r "/Users/wm/Projects/Auto-Claude-001-features-develop/.envrc" "/Users/wm/Projects/Auto-Claude-001-features-develop/.direnv"/*.rc
